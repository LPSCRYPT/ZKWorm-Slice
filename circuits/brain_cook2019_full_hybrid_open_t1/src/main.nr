fn pl_boltz(v:u32,vh:u32,kw:u32)->u32{let width=2*kw;let low=if vh>=width{vh-width}else{0};let high=vh+width;if v>=high{GATE_SCALE}else if v<=low{0}else{(v-low)*GATE_SCALE/(high-low)}}
fn pl_boltz_inv(v:u32,vh:u32,kw:u32)->u32{GATE_SCALE-pl_boltz(v,vh,kw)}
fn syn_sig(v:u32)->u32{pl_boltz(v,VH_SYN,SIG_W)}
fn motor_act(v:u32)->u32{pl_boltz(v,MOTOR_VH,MOTOR_KW)}
fn relax(x_old:u32,x_inf:u32,decay:u32)->u32{if x_old>=x_inf{x_inf+(x_old-x_inf)*decay/GATE_SCALE}else{x_inf-(x_inf-x_old)*decay/GATE_SCALE}}
fn sm_abs(x:u32)->u32{if x>=R_NEG_BASE{x-R_NEG_BASE}else{x}}
fn sm_neg(x:u32)->bool{x>=R_NEG_BASE}
fn sm_enc(abs:u32, neg:bool)->u32{if abs==0{0}else if neg{R_NEG_BASE+abs}else{abs}}
fn randi_activity(v:u32)->u32{if v<=18000{0}else if v>=58000{SCALE}else{(v-18000)*SCALE/40000}}
fn randi_update(v_pre:[u32; 302], randi_init:[u32; 302]) -> ([u32; 302], [u32; 302]) {
    let mut drive_pos:[u32; 302] = [0; 302]; let mut drive_neg:[u32; 302] = [0; 302];
    let mut act:[u32; 302] = [0; 302]; for i in 0..302 { act[i] = randi_activity(v_pre[i]); }
    for k in 0..723 { let post=RANDI_POS_POST[k]; let pre=RANDI_POS_PRE[k]; drive_pos[post] = drive_pos[post] + (RANDI_POS_W[k] * act[pre] / SCALE); }
    for k in 0..73 { let post=RANDI_NEG_POST[k]; let pre=RANDI_NEG_PRE[k]; drive_neg[post] = drive_neg[post] + (RANDI_NEG_W[k] * act[pre] / SCALE); }
    let mut state_out:[u32; 302] = [0; 302]; let mut syn_gain:[u32; 302] = [SCALE; 302];
    for i in 0..302 {
        let old_abs = sm_abs(randi_init[i]); let old_neg = sm_neg(randi_init[i]);
        let mut pos64: u64 = (drive_pos[i] as u64) * (R_ALPHA as u64);
        let mut neg64: u64 = (drive_neg[i] as u64) * (R_ALPHA as u64);
        if old_neg { neg64 = neg64 + (old_abs as u64) * ((R_SCALE - R_ALPHA) as u64); } else { pos64 = pos64 + (old_abs as u64) * ((R_SCALE - R_ALPHA) as u64); }
        let pos = (pos64 / (R_SCALE as u64)) as u32; let neg = (neg64 / (R_SCALE as u64)) as u32;
        let is_neg = neg > pos; let abs = if is_neg { neg - pos } else { pos - neg };
        state_out[i] = sm_enc(abs, is_neg);
        let mut mod_enc = abs * RANDI_GAIN_ENC / R_SCALE;
        if mod_enc > RANDI_CLIP_ENC { mod_enc = RANDI_CLIP_ENC; }
        syn_gain[i] = if is_neg { if mod_enc >= SCALE {0} else {SCALE - mod_enc} } else { SCALE + mod_enc };
    }
    (state_out, syn_gain)
}
fn neural_step(v_in:[u32; 302],n_in:[u32; 302],p_in:[u32; 302],q_in:[u32; 302],e_in:[u32; 302],f_in:[u32; 302],cai_in:[u32; 302],i_ext:[u32; 302],syn_gain:[u32; 302]) -> ([u32; 302],[u32; 302],[u32; 302],[u32; 302],[u32; 302],[u32; 302],[u32; 302]) {
 let mut g_pre:[u32; 302]=[0; 302]; for j in 0..302{g_pre[j]=syn_sig(v_in[j]);}
 let mut i_syn_pos:[u32; 302]=[0; 302]; let mut i_syn_neg:[u32; 302]=[0; 302];
 for k in 0..3709{let pre=SYN_PRE[k];let post=SYN_POST[k];let tmp=SYN_W[k]*G_SYN_ENC*g_pre[pre]/SCALE*syn_gain[post]/SCALE;let er=E_PRE[pre];let vp=v_in[post];if er>=vp{i_syn_pos[post]=i_syn_pos[post]+tmp*(er-vp)/SCALE;}else{i_syn_neg[post]=i_syn_neg[post]+tmp*(vp-er)/SCALE;}}
 let mut i_gap_pos:[u32; 302]=[0; 302]; let mut i_gap_neg:[u32; 302]=[0; 302];
 for k in 0..2199{let ii=GAP_I[k];let jj=GAP_J[k];let w=GAP_W[k];let vi=v_in[ii];let vj=v_in[jj];if vj>vi{let cur=w*G_GAP_ENC*(vj-vi)/SCALE/SCALE;i_gap_pos[ii]=i_gap_pos[ii]+cur;i_gap_neg[jj]=i_gap_neg[jj]+cur;}else if vi>vj{let cur=w*G_GAP_ENC*(vi-vj)/SCALE/SCALE;i_gap_neg[ii]=i_gap_neg[ii]+cur;i_gap_pos[jj]=i_gap_pos[jj]+cur;}}
 let mut v_out:[u32; 302]=[0; 302];let mut n_out:[u32; 302]=[0; 302];let mut p_out:[u32; 302]=[0; 302];let mut q_out:[u32; 302]=[0; 302];let mut e_out:[u32; 302]=[0; 302];let mut f_out:[u32; 302]=[0; 302];let mut cai_out:[u32; 302]=[0; 302];
 for i in 0..302{let v=v_in[i];let mut pos=i_syn_pos[i]+i_gap_pos[i]+i_ext[i];let mut neg=i_syn_neg[i]+i_gap_neg[i];if v>=E_LEAK{neg=neg+G_LEAK_ENC*(v-E_LEAK)/SCALE;}else{pos=pos+G_LEAK_ENC*(E_LEAK-v)/SCALE;}if v>=E_K{let drv=v-E_K;neg=neg+G_KSLOW_ENC*n_in[i]/SCALE*drv/SCALE;let p2=p_in[i]*p_in[i]/GATE_SCALE;let p4=p2*p2/GATE_SCALE;neg=neg+G_KFAST_ENC*(p4*q_in[i]/GATE_SCALE)/SCALE*drv/SCALE;}let e2=e_in[i]*e_in[i]/GATE_SCALE;let e2f=e2*f_in[i]/GATE_SCALE;let h_inf=pl_boltz_inv(cai_in[i],CA_HALF_ENC,KH_ABS_ENC);let fc=if h_inf>=GATE_SCALE{GATE_SCALE}else{GATE_SCALE-(GATE_SCALE-h_inf)*ALPHA_ENC/SCALE};let i_ca_raw=G_CA_ENC*(e2f*fc/GATE_SCALE)/SCALE;if v<=E_CA{pos=pos+i_ca_raw*(E_CA-v)/SCALE;}else{neg=neg+i_ca_raw*(v-E_CA)/SCALE;}let v_new=if pos>=neg{let dv=DT_ENC*(pos-neg)/SCALE;let vn=v+dv;if vn>=V_MAX{V_MAX}else{vn}}else{let dv=DT_ENC*(neg-pos)/SCALE;if dv>=v{V_MIN}else{v-dv}};v_out[i]=v_new;n_out[i]=relax(n_in[i],pl_boltz(v_new,VH_N,KW_N),DECAY_N);p_out[i]=relax(p_in[i],pl_boltz(v_new,VH_P,KW_P),DECAY_P);q_out[i]=relax(q_in[i],pl_boltz_inv(v_new,VH_Q,KW_Q),DECAY_Q);e_out[i]=relax(e_in[i],pl_boltz(v_new,VH_E,KW_E),DECAY_E);f_out[i]=relax(f_in[i],pl_boltz_inv(v_new,VH_F,KW_F),DECAY_F);let influx=if v<=E_CA{RHO_ENC*i_ca_raw/SCALE*(E_CA-v)/SCALE*DT_ENC/SCALE}else{0};let cai=cai_in[i];let cn=if cai>=CAI_BASELINE{let decay=(cai-CAI_BASELINE)*DT_ENC/TAU_CA_ENC;let c=cai+influx;if c>=decay{c-decay}else{0}}else{cai+influx+(CAI_BASELINE-cai)*DT_ENC/TAU_CA_ENC};cai_out[i]=if cn>=CAI_MAX{CAI_MAX}else{cn};}
 (v_out,n_out,p_out,q_out,e_out,f_out,cai_out)}
fn apply_hybrid_spikes(v_in:[u32; 302], cai_in:[u32; 302], i_ext:[u32; 302], refractory_init:[u32; 302]) -> ([u32; 302], [u32; 302], [u32; 302]) {
    let mut v_out = v_in; let mut cai_out = cai_in; let mut refractory_out:[u32; 302] = [0; 302];
    for i in 0..302 { refractory_out[i] = if refractory_init[i] > DT_ENC { refractory_init[i] - DT_ENC } else { 0 }; }
    for k in 0..4 {
        let idx = HYBRID_IDX[k];
        if refractory_out[idx] == 0 {
            let is_awa = HYBRID_IS_AWA[k] == 1;
            let is_dvb = HYBRID_IS_DVB[k] == 1;
            let ith = if is_awa { HYBRID_AWA_I_THRESH } else { HYBRID_OTHER_I_THRESH };
            let vth = if is_awa { HYBRID_AWA_V_THRESH } else { HYBRID_OTHER_V_THRESH };
            if i_ext[idx] >= ith | v_out[idx] >= vth {
                v_out[idx] = if is_dvb { HYBRID_DVB_SPIKE_V } else { HYBRID_AWA_SPIKE_V };
                let c = cai_out[idx] + HYBRID_CAI_DELTA;
                cai_out[idx] = if c > CAI_MAX { CAI_MAX } else { c };
                refractory_out[idx] = if is_awa { HYBRID_AWA_REF } else { HYBRID_OTHER_REF };
            }
        }
    }
    (v_out, cai_out, refractory_out)
}
fn motor_outputs(v:[u32; 302]) -> ([u32; 74], [u32; 48]) {
    let mut exc:[u32; 74] = [0; 74]; let mut inh:[u32; 74] = [0; 74];
    for k in 0..262 { let m=MUSCLE_EXC_M[k]; let idx=MUSCLE_EXC_N[k]; exc[m] = exc[m] + MUSCLE_EXC_W[k] * motor_act(v[idx]) / SCALE; }
    for k in 0..95 { let m=MUSCLE_INH_M[k]; let idx=MUSCLE_INH_N[k]; inh[m] = inh[m] + MUSCLE_INH_W[k] * motor_act(v[idx]) / SCALE; }
    let mut muscle:[u32; 74] = [0; 74];
    for m in 0..74 { let e = if MUSCLE_EXC_DEN[m] > 0 { exc[m] * SCALE / MUSCLE_EXC_DEN[m] } else { 0 }; let h = if MUSCLE_INH_DEN[m] > 0 { inh[m] * SCALE / MUSCLE_INH_DEN[m] } else { 0 }; muscle[m] = if e > h { e - h } else { 0 }; }
    let mut qsum:[u32; 48] = [0; 48]; let mut quadrants:[u32; 48] = [0; 48];
    for m in 0..74 { let q = MUSCLE_SEG[m] * 4 + MUSCLE_QUAD[m]; qsum[q] = qsum[q] + muscle[m]; }
    for q in 0..48 { quadrants[q] = if QUAD_DEN[q] > 0 { qsum[q] / QUAD_DEN[q] } else { 0 }; }
    (muscle, quadrants)
}
fn absorb_302(mut hs:[Field;4], xs:[u32; 302]) -> [Field;4] { for i in 0..100 { hs[0]=hs[0]+xs[i*3] as Field; hs[1]=hs[1]+xs[i*3+1] as Field; hs[2]=hs[2]+xs[i*3+2] as Field; hs=std::hash::poseidon2_permutation(hs,4); }
    hs[0] = hs[0] + xs[100*3] as Field; hs[1] = hs[1] + xs[100*3+1] as Field;
    hs = std::hash::poseidon2_permutation(hs, 4);
    hs
}
fn absorb_74(mut hs:[Field;4], xs:[u32; 74]) -> [Field;4] { for i in 0..24 { hs[0]=hs[0]+xs[i*3] as Field; hs[1]=hs[1]+xs[i*3+1] as Field; hs[2]=hs[2]+xs[i*3+2] as Field; hs=std::hash::poseidon2_permutation(hs,4); }
    hs[0] = hs[0] + xs[24*3] as Field; hs[1] = hs[1] + xs[24*3+1] as Field;
    hs = std::hash::poseidon2_permutation(hs, 4);
    hs
}
fn absorb_48(mut hs:[Field;4], xs:[u32; 48]) -> [Field;4] { for i in 0..16 { hs[0]=hs[0]+xs[i*3] as Field; hs[1]=hs[1]+xs[i*3+1] as Field; hs[2]=hs[2]+xs[i*3+2] as Field; hs=std::hash::poseidon2_permutation(hs,4); }
    hs
}
fn main(v_init:[u32; 302],n_init:[u32; 302],p_init:[u32; 302],q_init:[u32; 302],e_init:[u32; 302],f_init:[u32; 302],cai_init:[u32; 302],randi_state_init:[u32; 302],hybrid_refractory_init:[u32; 302],i_ext:[[u32; 302];1]) -> pub [Field; 3143] {
 let rg = randi_update(v_init, randi_state_init); let randi_state = rg.0; let syn_gain = rg.1;
 let result=neural_step(v_init,n_init,p_init,q_init,e_init,f_init,cai_init,i_ext[0],syn_gain);let nn=result.1;let pp=result.2;let qq=result.3;let ee=result.4;let ff=result.5;
 let hybrid=apply_hybrid_spikes(result.0,result.6,i_ext[0],hybrid_refractory_init);let v=hybrid.0;let ca=hybrid.1;let hybrid_refractory=hybrid.2;
 let mo = motor_outputs(v); let muscle = mo.0; let quadrants = mo.1;
 let mut hs:[Field;4]=[0;4];hs[3]=3143;hs=absorb_302(hs,v);hs=absorb_302(hs,nn);hs=absorb_302(hs,pp);hs=absorb_302(hs,qq);hs=absorb_302(hs,ee);hs=absorb_302(hs,ff);hs=absorb_302(hs,ca);hs=absorb_302(hs,randi_state);hs=absorb_302(hs,syn_gain);hs=absorb_302(hs,hybrid_refractory);hs=absorb_74(hs,muscle);hs=absorb_48(hs,quadrants);hs=std::hash::poseidon2_permutation(hs,4);let final_state_hash=hs[0];
    let mut out: [Field; 3143] = [0; 3143];
    out[0] = final_state_hash;
    for i in 0..302 {
        out[1 + i] = v[i] as Field; out[1 + 302 + i] = nn[i] as Field; out[1 + 604 + i] = pp[i] as Field; out[1 + 906 + i] = qq[i] as Field;
        out[1 + 1208 + i] = ee[i] as Field; out[1 + 1510 + i] = ff[i] as Field; out[1 + 1812 + i] = ca[i] as Field;
        out[2115 + i] = randi_state[i] as Field; out[2417 + i] = syn_gain[i] as Field; out[2719 + i] = hybrid_refractory[i] as Field;
    }
    for i in 0..74 { out[3021 + i] = muscle[i] as Field; }
    for i in 0..48 { out[3095 + i] = quadrants[i] as Field; }
    out
}
